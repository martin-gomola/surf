# Surf release metadata used to build this fork's backend and embed its client.
SURF_VERSION=0.17.100
SURF_COMPATIBILITY=1

# Surf's own TLS listener is published on this Mac's LAN at port 18080.
SURF_SERVER_NAME="Home Surf"
# Replace the example hostname with the NPM hostname for this Surf instance.
SURF_PUBLIC_ADDRESS=surf.example.com:443
SURF_TUNNEL_HOST=surf.example.com
# Set to false temporarily if a site challenge fails to load in Surf.
SURF_CONTENT_BLOCKER=true
SURF_ADAPTIVE_VIDEO=true
SURF_SUSPEND_SILENT_AUDIO=true
STREAM_MAX_FPS=30
SURF_PORT=18080
SURF_DASHBOARD_PORT=18081
SURF_DATA_ROOT=${HOME}/srv/docker/surf
